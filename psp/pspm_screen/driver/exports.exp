PSP_BEGIN_EXPORTS

PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC(module_start)
PSP_EXPORT_FUNC(module_stop)
PSP_EXPORT_VAR(module_info)
PSP_EXPORT_END

# 0x4001: callable from user mode (the PSPM Screen app) through syscalls
PSP_EXPORT_START(pspm_usb, 0, 0x4001)
PSP_EXPORT_FUNC(pspmUsbStart)
PSP_EXPORT_FUNC(pspmUsbRead)
PSP_EXPORT_FUNC(pspmUsbWrite)
PSP_EXPORT_END

PSP_END_EXPORTS
